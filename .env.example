# کپی این فایل به .env و مقداردهی آن
# روی سرور، اسکریپت setup.sh این فایل را خودکار می‌سازد.

# اتصال دیتابیس (الزامی)
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@127.0.0.1:5432/app_db

# پورت اپلیکیشن
PORT=3000
NODE_ENV=production

# انتشار واقعی تیک‌تاک (اختیاری — نیازمند مجوز TikTok for Developers)
# TIKTOK_CLIENT_KEY=xxxx
# TIKTOK_CLIENT_SECRET=xxxx
# TIKTOK_ACCESS_TOKEN=xxxx
